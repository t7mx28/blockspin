local AIM_MODES = {
    {part = "UnderfootRPG"},
    {part = "Head"},
    {part = "HumanoidRootPart"},
}
local currentModeIndex = 1

local function UpdateProtectedList()
    for _, b in pairs(PlayerButtons) do b:Destroy() end
    PlayerButtons = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local btn = Instance.new("TextButton", PlayerListFrame)
            btn.Size = UDim2.new(1, -4, 0, 22)
            btn.Active = true
            local prot = ProtectedPlayers[p] or false
            btn.BackgroundColor3 = prot and Color3.fromRGB(110, 0, 220) or Color3.fromRGB(35, 35, 48)
            btn.Text = p.DisplayName .. (prot and " [Protected]" or "")
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.TextSize = 11
            btn.Font = Enum.Font.Gotham
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            table.insert(PlayerButtons, btn)

            btn.MouseButton1Click:Connect(function()
                ProtectedPlayers[p] = not ProtectedPlayers[p]
                UpdateProtectedList()
            end)
        end
    end
end
