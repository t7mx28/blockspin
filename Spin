local function getEnglishName(t)
    if not t or not t.Name then return nil end
    local originalName = t.Name
    if nameCache[originalName] then return nameCache[originalName] end
    local cleanName = originalName:gsub("Item", ""):gsub("_", " ")
    nameCache[originalName] = cleanName
    return cleanName
end

local function updateESP(p)
    local bb = BillboardCache[p]
    if not bb then return end
    
    local char = p.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then 
        bb.Enabled = false
        return 
    end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    local lChar = LocalPlayer.Character
    if lChar and lChar:FindFirstChild("HumanoidRootPart") then
        local dist = (lChar.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
        if dist > MAX_DISTANCE then
            bb.Enabled = false
            return
        end
    end

    local container = bb:FindFirstChild("EspContainer")
    if not container then return end
    container:ClearAllChildren()

    -- 1. اسم اللاعب (Username)
    local nameLbl = Instance.new("TextLabel", container)
    nameLbl.Size = UDim2.new(0, 200, 0, 18)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = p.DisplayName
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 13
    nameLbl.TextStrokeTransparency = 0.1
    nameLbl.TextColor3 = Color3.fromRGB(255, 80, 255)

    -- 2. الهيل (HP) بعيد ومفصول عن الاسم بمسافة مرتبة
    if hum then
        local space1 = Instance.new("Frame", container)
        space1.Size = UDim2.new(0, 200, 0, 4)
        space1.BackgroundTransparency = 1

        local hpLbl = Instance.new("TextLabel", container)
        hpLbl.Size = UDim2.new(0, 200, 0, 16)
        hpLbl.BackgroundTransparency = 1
        local healthPercent = math.clamp(math.floor((hum.Health / hum.MaxHealth) * 100), 0, 100)
        hpLbl.Text = "HP: " .. healthPercent .. "%"
        hpLbl.Font = Enum.Font.GothamBold
        hpLbl.TextSize = 12
        hpLbl.TextStrokeTransparency = 0.2
        hpLbl.TextColor3 = Color3.fromRGB(255 - (healthPercent * 1.5), healthPercent * 2.2, 50)
    end

    local tools = {}
    if p:FindFirstChild("Backpack") then
        for _, t in ipairs(p.Backpack:GetChildren()) do
            if t:IsA("Tool") then table.insert(tools, t) end
        end
    end
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") then table.insert(tools, t) end
        end
    end

    bb.Enabled = espInventoryEnabled
    
    -- 3. اللوت (الأدوات) تحت الهيل بمسافة واضحة وغير متلاصقة
    if #tools > 0 then
        local space2 = Instance.new("Frame", container)
        space2.Size = UDim2.new(0, 200, 0, 6)
        space2.BackgroundTransparency = 1

        for _, tool in ipairs(tools) do
            local name = getEnglishName(tool)
            if name then
                local lbl = Instance.new("TextLabel", container)
                lbl.Size = UDim2.new(0, 200, 0, 15)
                lbl.BackgroundTransparency = 1
                lbl.Text = name
                lbl.Font = Enum.Font.GothamMedium
                lbl.TextSize = 11
                lbl.TextStrokeTransparency = 0.2
                lbl.TextColor3 = Color3.fromRGB(0, 255, 170)
            end
        end
    end
end

local function createESP(p)
    if p == LocalPlayer then return end
    
    local function setup(char)
        if not char then return end
        local root = char:WaitForChild("HumanoidRootPart", 15)
        local hum = char:WaitForChild("Humanoid", 15)
        if not root then return end
        
        if BillboardCache[p] then 
            pcall(function() BillboardCache[p]:Destroy() end)
        end
        
        local bb = Instance.new("BillboardGui")
        bb.Name = "t7mx_ESP"
        bb.Parent = root
        bb.Size = UDim2.new(0, 220, 0, 300)
        bb.StudsOffset = Vector3.new(0, -5.5, 0) -- تحت الأقدام بمسافة عميقة وواضحة جداً
        bb.AlwaysOnTop = true
        bb.MaxDistance = MAX_DISTANCE
        
        local cont = Instance.new("Frame", bb)
        cont.Name = "EspContainer"
        cont.Size = UDim2.new(1, 0, 1, 0)
        cont.BackgroundTransparency = 1
        
        local layout = Instance.new("UIListLayout", cont)
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.VerticalAlignment = Enum.VerticalAlignment.Top 
        layout.Padding = UDim.new(0, 2)
        
        BillboardCache[p] = bb
        updateESP(p)
        
        local bp = p:WaitForChild("Backpack", 5)
        if bp then
            bp.ChildAdded:Connect(function() updateESP(p) end)
            bp.ChildRemoved:Connect(function() updateESP(p) end)
        end
        char.ChildAdded:Connect(function(c) if c:IsA("Tool") then updateESP(p) end end)
        char.ChildRemoved:Connect(function(c) if c:IsA("Tool") then updateESP(p) end end)
        if hum then
            hum.HealthChanged:Connect(function() updateESP(p) end)
        end
    end
    
    p.CharacterAdded:Connect(setup)
    if p.Character then setup(p.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)

