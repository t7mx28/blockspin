local function IsAlive(char)
    local h = char and char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function GetTargetPosition(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not root then return nil end

    local mode = AIM_MODES[currentModeIndex]
    
    if mode.part == "Head" then
        return head and head.Position or root.Position
    elseif mode.part == "HumanoidRootPart" then
        return root.Position
    elseif mode.part == "UnderfootRPG" then
        local vel = root.Velocity
        local predictionMultiplier = 0.85 
        local predictedPos = root.Position + Vector3.new(vel.X * predictionMultiplier, vel.Y * 0.5, vel.Z * predictionMultiplier)
        predictedPos = predictedPos - Vector3.new(0, 4.0, 0)
        return predictedPos
    end
    return root.Position
end

local function GetClosest()
    local closest, distMin = nil, math.huge
    local center = Camera.ViewportSize / 2
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not ProtectedPlayers[p] and p.Character and IsAlive(p.Character) then
            local targetPos = GetTargetPosition(p.Character)
            if targetPos then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < distMin and dist <= FOVRadius then
                        distMin = dist
                        closest = p
                    end
                end
            end
        end
    end
    return closest
end

local function drinkSlot2Only()
    pcall(function()
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        local tools = {}
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then table.insert(tools, t) end
            end
        end
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") then table.insert(tools, t) end
        end
        
        local drinkTool = tools[2]
        if drinkTool and drinkTool:IsA("Tool") then
            hum:EquipTool(drinkTool)
            task.wait(0.05)
            drinkTool:Activate()
        end
    end)
end

RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Camera.ViewportSize / 2
    FOVCircle.Radius = FOVRadius
    FOVCircle.Visible = AimbotOn
    
    if AimbotOn then
        local target = GetClosest()
        if target and target.Character then
            local targetPos = GetTargetPosition(target.Character)
            if targetPos then
                local cf = CFrame.new(Camera.CFrame.Position, targetPos)
                Camera.CFrame = Camera.CFrame:Lerp(cf, AIM_SMOOTHNESS)
            end
        end
    end
    
    if AutoDrinkOn then
        if tick() - lastDrinkTime >= DRINK_COOLDOWN then
            lastDrinkTime = tick()
            drinkSlot2Only()
        end
    end
end)

