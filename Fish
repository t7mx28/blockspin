local function addToggle(parent, title, callback)
	local toggle = fn("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = tbl.PanelLight,
		Text = "  " .. title,
		TextColor3 = tbl.Text,
		Font = gothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = parent,
	})
	fn("UICorner", { CornerRadius = UDim.new(0, 8), Parent = toggle })
	local state = false
	toggle.Activated:Connect(function()
		state = not state
		toggle.TextColor3 = state and tbl.Green or tbl.Text
		callback(state)
	end)
end

