local function createTab(name, iconId)
	local btn = fn("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = tbl.PanelLight,
		BackgroundTransparency = 0.5,
		AutoButtonColor = true,
		Font = gothamMedium,
		Text = "  " .. name,
		TextColor3 = tbl.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = ScrollingFrame,
	})
	fn("UICorner", { CornerRadius = UDim.new(0, 8), Parent = btn })
	
	local content = fn("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		Visible = false,
		CanvasSize = UDim2.fromOffset(0, 400),
		ZIndex = 3,
		Parent = Frame8,
	})
	fn("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = content })
	
	btn.Activated:Connect(function()
		for _, child in ipairs(Frame8:GetChildren()) do
			if child:IsA("ScrollingFrame") then child.Visible = false end
		end
		content.Visible = true
	end)
	return content
end

